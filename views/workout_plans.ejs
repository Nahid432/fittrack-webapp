<!doctype html>
<html>
  <head>
    <title>Workout Plans | <%= appData.appName %></title>
    <link rel="stylesheet"  type="text/css" href="/main.css" />
  </head>

  <body>
    <!--Top navigation bar-->
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1>My Workout Plans</h1>
    <a href="/workouts/create">Create Workout</a>

    <!--Display a message if the user has not created any workouts-->
    <% if (workouts.length === 0) { %> 

        <p>No workouts created yet.</p>

    <% } else { %>

        <!--Display each workout belonging to the logged-in user-->
        <% workouts.forEach(function(workout) { %>
            <div class="workout-card">
                <h3>
                    <a href="/workouts/<%= workout.id %>">
                        <%= workout.workout_name %>
                    </a>
                </h3>
            </div>
        <% }) %>
    <% } %>

  </body>
</html>