<!doctype html>
<html>
  <head>
    <title> <%= appData.appName %></title>
    <link rel="stylesheet"  type="text/css" href="/main.css" />
  </head>

  <body>
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1>Welcome to <%= appData.appName %></h1>
    <p>
      FitTrack helps users explore exercises and create personalised workouts.
    </p>
    
      <% if (loggedInUser) { %>
          <span>Welcome, <%= loggedInUser.username %></span>
          <a href="/workouts">My Workouts</a>
          <a href="/users/logout">Logout</a>
      <% } else { %>
          <a href="/users/login">Login</a>
      <% } %>
  </body>
</html>
