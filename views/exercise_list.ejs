<!doctype html>
<html>
  <head>
    <title>Exercises | <%= appData.appName %></title>
    <link rel="stylesheet" type="text/css" href="/main.css">
  </head>

  <body>
    <!--Top navigation bar-->
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1>Exercise Library</h1>

    <p>
      Browse the exercises currently available in FitTrack.
    </p>
    <!--Exercise search and filtering form -->
    <form method="GET" action="/exercises/list">

      <label for="exercise_name">Search by exercise name</label>
      <input type="text" name="exercise_name" value="<%= exerciseName %>"/>

      <label for="muscle_group">Muscle group</label>
      <select name="muscle_group">
        <option value="">All muscles</option>
        <option value="Chest" >Chest</option>
        <option value="Back">Back</option>
        <option value="Legs">Legs</option>
        <option value="Shoulders">Shoulders</option>
        <option value="Arms">Arms</option>
        <option value="Core">Core</option>
      </select>

      <button type="submit">Search</button>
    
    </form>
    <!--No results message-->
    <% if (availableExercises.length === 0) { %>
       <p>No exercises match your search.</p>
    <% } 
      else { %>
          <!--Exercise results-->

          <% availableExercises.forEach(function(exercise) { %>

              <div class="exercise-card">

                  <h3><%= exercise.name %></h3>

                  <p><%= exercise.description %></p>

                  <p><strong>Muscle:</strong> <%= exercise.muscle_group %></p>

              </div>

          <% }) %>

    <% } %>

    <p>
      <a href="/">Return to homepage</a>
    </p>
  </body>
</html>