<!doctype html>
<html>
  <head>
    <title>Register | <%= appData.appName %></title>
    <link rel="stylesheet" type="text/css" href="/main.css">
  </head>

  <body>
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1>Register to create your FitTrack account</h1>
    <!--Registration form-->
    <form method="POST" action="/users/registered">
        <p>First name: <input id="first" type="text" name="first" required></p>
        <p>Last name: <input id="last" type="text" name="last" required></p>
        <p>Username: <input id="username" type="text" name="username" required></p>
        <p>Email: <input id="email" type="email" name="email" required></p>
        <p>Password: <input id="password" type="password" name="password" required></p>
        <input type="submit" value="Register" />
    </form>
    <!--Existing user link-->
    <p> Already have an account?
      <a href="/users/login">Login</a>
    </p>
  </body>
</html>