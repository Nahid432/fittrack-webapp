<!doctype html>
<html>
  <head>
    <title>Register | <%= appData.appName %></title>
    <link rel="stylesheet" type="text/css" href="/main.css">
  </head>

  <body>
    <h1>Register to create your FitTrack account</h1>
    <!--Registration form-->
    <form method="POST" action="/users/registered">
        <p>First name: <input id="first" type="text" name="first" /></p>
        <p>Last name: <input id="last" type="text" name="last"/></p>
        <p>Username: <input id="username" type="text" name="username"/></p>
        <p>Email: <input id="email" type="email" name="email"/></p>
        <p>Password: <input id="password" type="password" name="password"/></p>
        <input type="submit" value="Register" />
    </form>
    <!--Existing user link-->
    <p> Already have an account?
      <a href="/users/login">Login</a>
    </p>
  </body>
</html>