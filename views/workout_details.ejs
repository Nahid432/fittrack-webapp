<!doctype html>
<html>
  <head>
    <title><%= workout.workout_name %> | <%= appData.appName %></title>
    <link rel="stylesheet"  type="text/css" href="/main.css" />
  </head>

  <body>
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1><%= workout.workout_name %></h1>
    

    <% if (exercises.length === 0) { %>

    <p>No exercises added yet.</p>

    <% } else { %>

        <% exercises.forEach(function(exercise) { %>
    
            <div class="exercise-card">
                <h3><%= exercise.name %></h3>
                <p><%= exercise.muscle_group %></p>
                <p>Sets: <%= exercise.set_count %></p>
                <p>Reps: <%= exercise.rep_count %></p>
                
                <form method="POST"
                action="/workouts/<%= workout.id %>/exercises/<%= exercise.id %>/delete">

                <button type="submit">Remove Exercise</button>
            </form>
            </div>

            

        <% }) %>

    <% } %>
    <a href="/workouts/<%= workout.id %>/add">
        Add Exercises
    </a>
    <p>
        <a href="/workouts">Return to workout plans</a>
    </p>

  </body>
</html>