<!doctype html>
<html>
  <head>
    <title>Login | <%= appData.appName %></title>
    <link rel="stylesheet" type="text/css" href="/main.css">
  </head>

  <body>
    <!--Top navigation bar-->
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1>Login</h1>
    <!--Login form-->
    <form method="POST" action="/users/loggedin">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" required/>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required/>

        <button type="submit">Login</button>
    </form>
    <!--Register page link-->
    <p>Don't have an account?
      <a href="/users/register">Register</a>
    </p>
  </body>
</html>