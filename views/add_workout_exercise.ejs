<!doctype html>
<html>
  <head>
    <title>Create Workout | <%= appData.appName %></title>
    <link rel="stylesheet"  type="text/css" href="/main.css" />
  </head>

  <body>
    <!--Top navigation bar-->
    <header class="top-banner">
        <a class="site-name" href="/">FitTrack</a>

        <nav>
            <a href="/">Home</a>
            <a href="/exercises/list">Exercises</a>
            <a href="/workouts">Workout Plans</a>
            <a href="/external/meals">Meal Ideas</a>
            <a href="/about">About</a>
            <a href="/users/login">Login</a>
        </nav>
    </header>
    <h1>Add Exercise to <%= workout.workout_name %></h1>

    <% exercises.forEach(function(exercise) { %>

        <div class="exercise-card">

            <h3><%= exercise.name %></h3>

            <p><%= exercise.description %></p>

            <p><%= exercise.muscle_group %></p>

            <!--Form for adding an exercise to the selected workout-->
            <form method="POST" action="/workouts/<%= workout.id %>/exercises/<%= exercise.id %>/add">

                <button type="submit">
                    Add
                </button>

            </form>

        </div>

        <hr>

    <% }) %>
  </body>
</html>